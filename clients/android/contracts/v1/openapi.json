  "components": {
    "securitySchemes": {
      "nativeSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque revocable 24-hour session; not JWT. No refresh endpoint."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "writeOnly": true
          },
          "transport": {
            "type": "string",
            "enum": [
              "native"
            ]
          }
        },
        "required": [
          "phone",
          "password",
          "transport"
        ],
        "additionalProperties": false
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "writeOnly": true
          },
          "transport": {
            "type": "string",
            "enum": [
              "native"
            ]
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "phone",
          "password",
          "transport",
          "code"
        ],
        "additionalProperties": false
      },
      "AcceptRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "SessionToken": {
        "type": "object",
        "properties": {
          "expires_in": {
            "type": "integer",
            "enum": [
              86400
            ]
          },
          "access_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          }
        },
        "required": [
          "expires_in",
          "access_token",
          "token_type"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "phone_login": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        },
        "required": [
          "account_id",
          "phone_login",
          "memberships"
        ],
        "additionalProperties": false
      },
      "Membership": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "rejected",
              "revoked"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "contributor",
              "owner"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "originals": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "library_id",
          "status",
          "role",
          "revision",
          "expires_at",
          "originals",
          "available"
        ],
        "additionalProperties": false
      },
      "Asset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Positive int64 decimal; retain as a string."
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "other"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_sec": {
            "type": [
              "number",
              "null"
            ]
          },
          "taken_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnail_url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "width",
          "height",
          "duration_sec",
          "taken_at",
          "thumbnail_url"
        ],
        "additionalProperties": false
      },
      "Gallery": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "originals_allowed": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          }
        },
        "required": [
          "library_id",
          "page",
          "page_size",
          "total",
          "originals_allowed",
          "items"
        ],
        "additionalProperties": false
      },
      "Detail": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string"
          },
          "originals_allowed": {
            "type": "boolean"
          },
          "asset": {
            "$ref": "#/components/schemas/Asset"
          }
        },
        "required": [
          "library_id",
          "originals_allowed",
          "asset"
        ],
        "additionalProperties": false
      },
      "Caption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Positive int64 decimal; retain as a string."
          },
          "text": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          },
          "user_edited": {
            "type": "boolean"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "truncated",
          "user_edited",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "Captions": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Positive int64 decimal; retain as a string."
          },
          "has_more": {
            "type": "boolean",
            "description": "True when rows are omitted by the 20-row or 524288-byte response limit; independent of per-item text truncation."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Caption"
            }
          }
        },
        "required": [
          "library_id",
          "asset_id",
          "has_more",
          "items"
        ],
        "additionalProperties": false,
        "description": "Complete encoded UTF-8 JSON response is at most 524288 bytes including envelope and escaping; ordered prefix of up to 20 whole rows. No caption pagination endpoint."
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "additionalProperties": false
      }
    }
  }
